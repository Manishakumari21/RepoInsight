# Copy to .env and adjust. Never commit real secrets (.env is gitignored).
# Only variables actually consumed by this deployment are listed.

# GitHub API token for the backend (optional but recommended).
# Without it, GitHub-mode analysis is limited to 60 API calls/hour.
GITHUB_TOKEN=

# /api/local/* routes read server-side filesystem paths. Keep enabled (1)
# for private/self-hosted use; set to 0 to disable them on a public
# deployment (the backend then answers those routes with 403).
LOCAL_API_ENABLED=1

# Backend bind port inside its container (HOST is fixed to 0.0.0.0 by the
# backend image). Change only if 3000 collides inside the compose network.
# PORT=3000
