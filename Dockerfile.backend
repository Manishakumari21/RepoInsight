# RepoInsight backend — multi-stage production image.
#
# Builder compiles the Rust/Axum binary in release mode (Cargo.lock pins
# exact dependency versions for reproducibility). The runtime image is a
# slim Debian with only what the binary needs at runtime:
#   - git binary  (backend/src/local.rs shells out to `git`)
#   - CA certificates (outbound HTTPS to api.github.com via reqwest/rustls)
# libgit2/OpenSSL are statically linked into the binary (no dynamic
# libgit2 dependency; verified with ldd).
# No Python runtime is included: ML inference is embedded in the binary
# (backend/src/prediction/weights.json is compiled in via include_str!);
# the Python package is training/research tooling only.

FROM rust:1.90-bookworm AS builder

WORKDIR /build

# Dependency layer first for better caching.
COPY backend/Cargo.toml backend/Cargo.lock ./
RUN mkdir -p src && echo 'fn main() {}' > src/main.rs && cargo build --release

COPY backend/src ./src
COPY tests/backend/evaluation/rework_labels.csv /tests/backend/evaluation/rework_labels.csv
RUN cargo build --release

FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*

# Non-root execution.
RUN useradd --create-home --shell /usr/sbin/nologin repoinsight
USER repoinsight
WORKDIR /home/repoinsight

COPY --from=builder --chown=repoinsight:repoinsight /build/target/release/repoinsight-backend ./repoinsight-backend

ENV HOST=0.0.0.0
ENV PORT=3000
EXPOSE 3000
EXPOSE 10000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:${PORT:-3000}/health || exit 1

CMD ["./repoinsight-backend"]
